{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Pearl",
	"slug": "gem-pearl",
	"blockTypes": [
		"core/group",
		"core/cover"
	],
	"styles": {
		"color": {
			"background": "#f3f3f1",
			"text": "#1d1f24"
		},
		"spacing": {
			"padding": {
				"top": "clamp(3.5rem, 9vw, 8rem)",
				"bottom": "clamp(3.5rem, 9vw, 8rem)",
				"left": "clamp(1.25rem, 5vw, 4rem)",
				"right": "clamp(1.25rem, 5vw, 4rem)"
			}
		},
		"elements": {
			"heading": {
				"color": {
					"text": "#1d1f24"
				}
			},
			"link": {
				"color": {
					"text": "#1d1f24"
				}
			}
		},
		"css": "--nelyqo-ground: #f3f3f1; --nelyqo-muted: #5b606c; --nelyqo-m1: #7d6f88; --nelyqo-m2: #6d7a91; --nelyqo-m3: #5e6b7e; --nelyqo-m4: #857786; --nelyqo-m5: #4a5262; & + * { --nelyqo-from: #f3f3f1; }"
	}
}
